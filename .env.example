# Copy to .env and fill in. Values come from Firebase console > Project settings > Your apps.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# comma-separated email/password accounts that are invigilators
INVIGILATOR_EMAILS=
